# ${PORT} is substituted by the nginx:alpine entrypoint at container start.
# Only names that exist in the environment are substituted, so nginx's own $uri and friends
# are left alone.

server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Every one of the 35 routes is prerendered, so an unmatched path is a genuine 404
    # rather than a client route we should hand to the SPA.
    location / {
        try_files $uri $uri/index.html =404;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        add_header Cache-Control "no-store";
    }

    # Content-hashed bundles: safe to cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # Fonts are versioned by name and never edited in place.
    location /fonts/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    location ~* ^/(images|logo)/ {
        add_header Cache-Control "public, max-age=2592000" always;
        access_log off;
    }

    location = /favicon.png {
        add_header Cache-Control "public, max-age=2592000" always;
        access_log off;
    }

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/x-font-ttf font/woff2;

    # woff2 is already compressed; don't waste CPU re-compressing it.
    gzip_disable      "msie6";

    server_tokens     off;
    add_header        X-Content-Type-Options "nosniff" always;
    add_header        Referrer-Policy "strict-origin-when-cross-origin" always;
}
